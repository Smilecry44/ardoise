# ---------- veilleur : historique, événements, fuites, alertes ----------

STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", f"{HOME}/.local/state"), "ardoise")
HISTORY = os.path.join(STATE_DIR, "historique.jsonl")
KEEP_HOURS = 48


def _gb(v):
    if v >= GO:
        return T(f"{v / GO:.1f} Go".replace(".", ","), f"{v / GO:.1f} GB")
    return f"{v / 1024 ** 2:.0f} {MO_U}"


class Watcher:
    """Ce que le flux surveille dans le temps. Un seul flux (le « chef », qui tient un verrou)
    écrit l'historique sur le disque et envoie les notifications ; les autres calculent
    la même chose pour leur affichage, sans rien écrire."""

    def __init__(self, threshold=85):
        import fcntl
        self.fcntl = fcntl
        self.threshold = threshold
        self.lock_file = None
        self.leader = False
        self.try_lead()
        self.acc = []                 # relevés système de la minute en cours
        self.minute_start = time.time()
        self.breakdown = None         # dernière répartition [sessions, applis, /tmp, noyau, écart]
        self.used = 0
        self.prev_groups = None       # id -> (nom, mémoire, genre) au bilan précédent
        self.known = None             # groupes établis (vus sur deux bilans de suite)
        self.missing = {}             # id -> nombre de bilans où un groupe établi manque
        self.mem_series = {}          # id -> [(t, mémoire)] pour les fuites
        self.leaks = {}               # id -> pente en octets/heure
        self.leak_notified = {}
        self.over = 0
        self.alerted_at = 0
        self.alert_armed = True

    def try_lead(self):
        if self.leader:
            return
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            f = open(os.path.join(f"/run/user/{UID}", "ardoise.chef"), "w")
            self.fcntl.flock(f, self.fcntl.LOCK_EX | self.fcntl.LOCK_NB)
            self.lock_file, self.leader = f, True
            self.trim()
        except OSError:
            self.leader = False

    # -- historique --
    def trim(self):
        cutoff = time.time() - KEEP_HOURS * 3600
        try:
            lines = open(HISTORY).read().splitlines()
        except OSError:
            return
        keep = [l for l in lines if l and json.loads(l).get("t", 0) >= cutoff]
        if len(keep) != len(lines):
            with open(HISTORY + ".tmp", "w") as f:
                f.write("\n".join(keep) + ("\n" if keep else ""))
            os.replace(HISTORY + ".tmp", HISTORY)

    def write(self, rec):
        if not self.leader:
            return
        try:
            with open(HISTORY, "a") as f:
                f.write(json.dumps(rec, ensure_ascii=False, separators=(",", ":")) + "\n")
        except OSError:
            pass

    def backlog(self, hours=24):
        cutoff = time.time() - hours * 3600
        points, events = [], []
        try:
            for l in open(HISTORY):
                try:
                    r = json.loads(l)
                except ValueError:
                    continue
                if r.get("t", 0) < cutoff:
                    continue
                (events if r.get("k") == "event" else points).append(r)
        except OSError:
            pass
        return dict(type="hist", points=points, events=events)

    def on_system(self, sysd):
        """Accumule les relevés de 2 s ; toutes les minutes, rend un point d'historique."""
        self.acc.append(sysd)
        now = time.time()
        if now - self.minute_start < 60 or not self.acc:
            return None
        n = len(self.acc)
        avg = lambda f: sum(f(x) for x in self.acc) / n
        point = dict(k="min", t=round(now), cpu=round(avg(lambda x: x["cpu"]), 1),
                     used=round(avg(lambda x: x["used"])), total=self.acc[-1]["total"],
                     rx=round(avg(lambda x: x["net"]["rx"])), tx=round(avg(lambda x: x["net"]["tx"])),
                     rd=round(avg(lambda x: x["disk"]["read"])), wr=round(avg(lambda x: x["disk"]["write"])),
                     gpu=round(avg(lambda x: x["gpu"]["busy"] or 0), 1),
                     parts=[round(v) for v in self.breakdown] if self.breakdown else None)
        self.acc = []
        self.minute_start = now
        self.write(point)
        if self.leader and int(now) % 3600 < 60:
            self.trim()
        return dict(type="minute", point=point)

    # -- bilans : événements, fuites, alertes --
    def on_bilan(self, b):
        now = time.time()
        out = []
        sess = sum(g["ram"] + g["zram"] for g in b["groups"] if g["kind"] == "claude")
        apps = sum(g["ram"] + g["zram"] for g in b["groups"] if g["kind"] != "claude")
        p = b["personne"]
        self.breakdown = [sess, apps, p["files_ram"] + p["files_zram"], p["kernel"] + p["reserve"] + p["gpu"], max(0, b["ecart"])]
        self.used = b["used"]

        # ouvertures et fermetures : un groupe ne compte qu'une fois vu sur deux bilans de suite,
        # et n'est déclaré fermé qu'absent de deux bilans (les processus éclairs ne font pas de bruit)
        cur = {g["id"]: (g["name"], g["ram"] + g["zram"], g["kind"]) for g in b["groups"]}
        gmap = {g["id"]: g for g in b["groups"]}
        used = b["used"]
        notable = lambda kind, mem: kind == "claude" or mem > 150 * 1024 ** 2
        if self.known is None:
            self.known = dict(cur)
        else:
            for gid, (name, mem, kind) in cur.items():
                self.missing.pop(gid, None)
                if gid not in self.known and self.prev_groups and gid in self.prev_groups:
                    self.known[gid] = cur[gid]
                    if notable(kind, mem):
                        out.append(self.event(now, "open", T(f"session {name} ouverte", f"session {name} opened") if kind == "claude" else T(f"{name} lancé ({_gb(mem)})", f"{name} started ({_gb(mem)})"),
                                              name=name, group=kind, delta=round(mem), used=round(used)))
                elif gid in self.known:
                    self.known[gid] = cur[gid]
            for gid in list(self.known):
                if gid in cur:
                    continue
                self.missing[gid] = self.missing.get(gid, 0) + 1
                if self.missing[gid] >= 2:
                    name, mem, kind = self.known.pop(gid)
                    self.missing.pop(gid, None)
                    if notable(kind, mem):
                        out.append(self.event(now, "close", T(f"session {name} fermée", f"session {name} closed") if kind == "claude" else T(f"{name} fermé ({_gb(mem)} rendus)", f"{name} closed ({_gb(mem)} freed)"),
                                              name=name, group=kind, delta=-round(mem), used=round(used)))
        self.prev_groups = cur

        # fuites : une mémoire qui monte sans arrêt depuis au moins 25 minutes
        for gid, (name, mem, kind) in cur.items():
            ser = self.mem_series.setdefault(gid, [])
            if not ser or now - ser[-1][0] >= 55:
                ser.append((now, mem))
            while ser and now - ser[0][0] > 1800:
                ser.pop(0)
        for gid in list(self.mem_series):
            if gid not in cur:
                del self.mem_series[gid]
                self.leaks.pop(gid, None)
        for gid, ser in self.mem_series.items():
            self.leaks.pop(gid, None)
            if len(ser) < 20 or ser[-1][0] - ser[0][0] < 1500:
                continue
            xs = [t - ser[0][0] for t, _ in ser]
            ys = [m for _, m in ser]
            mx, my = sum(xs) / len(xs), sum(ys) / len(ys)
            sxx = sum((x - mx) ** 2 for x in xs)
            sxy = sum((x - mx) * (y - my) for x, y in zip(xs, ys))
            syy = sum((y - my) ** 2 for y in ys)
            if not sxx or not syy:
                continue
            slope = sxy / sxx * 3600
            r2 = sxy * sxy / (sxx * syy)
            if slope > 300 * 1024 ** 2 and r2 > 0.8 and ys[-1] - ys[0] > 200 * 1024 ** 2:
                self.leaks[gid] = slope
                if now - self.leak_notified.get(gid, 0) > 7200:
                    self.leak_notified[gid] = now
                    name = cur[gid][0]
                    g = gmap.get(gid, {})
                    out.append(self.event(now, "leak", T(f"fuite probable : {name} (+{_gb(slope)}/h)", f"probable leak: {name} (+{_gb(slope)}/h)"),
                                          name=name, group=cur[gid][2], slope=round(slope), mem=round(cur[gid][1]), used=round(used),
                                          delta=round(ys[-1] - ys[0]), pids=list(g.get("roots", []))[:8],
                                          series=[[round(t), round(m)] for t, m in ser]))
                    self.notify(T(f"Ardoise : {name} grossit sans arrêt", f"Ardoise: {name} keeps growing"),
                                T(f"+{_gb(slope)} par heure depuis 30 min, il pèse {_gb(cur[gid][1])}. Une fuite de mémoire ?",
                                  f"+{_gb(slope)} per hour for 30 min, now {_gb(cur[gid][1])}. A memory leak?"),
                                urgency="normal", actions=True)
        for g in b["groups"]:
            g["leak"] = self.leaks.get(g["id"], 0)

        # alerte : au-dessus du seuil sur deux bilans de suite, en nommant les coupables
        pct = 100 * b["used"] / b["total"]
        self.over = self.over + 1 if pct >= self.threshold else 0
        if pct < self.threshold - 5:
            self.alert_armed = True
        if self.over >= 2 and (self.alert_armed or now - self.alerted_at > 1800 and pct >= self.threshold + 5):
            self.alert_armed = False
            self.alerted_at = now
            why = self.culprits(b)
            out.append(self.event(now, "alert", T(f"alerte : RAM à {pct:.0f} %", f"alert: RAM at {pct:.0f}%"), pct=round(pct), used=round(b["used"]), detail=why))
            self.notify(T(f"RAM à {pct:.0f} % : voici qui la prend", f"RAM at {pct:.0f}%: here is who is using it"), why, urgency="critical", actions=True)
        return out

    def culprits(self, b):
        p = b["personne"]
        items = []
        tmp = p["files_ram"] + p["files_zram"]
        big_pad = max((g for g in b["groups"] if g["kind"] == "claude"), key=lambda g: g.get("scratch", 0), default=None)
        tmp_note = T(f" (dont le scratchpad de {big_pad['name']} : {_gb(big_pad['scratch'])})", f" (incl. {big_pad['name']}'s scratchpad: {_gb(big_pad['scratch'])})") if big_pad and big_pad.get("scratch", 0) > 500 * 1024 ** 2 else ""
        items.append((tmp, T("/tmp en RAM ", "/tmp in RAM ") + f"{_gb(tmp)}{tmp_note}"))
        for g in b["groups"]:
            mem = g["ram"] + g["zram"]
            label = f"session {g['name']}" if g["kind"] == "claude" else g["name"]
            items.append((mem, f"{label} {_gb(mem)}"))
        sess = [g for g in b["groups"] if g["kind"] == "claude"]
        if len(sess) > 3:
            items.append((sum(g["ram"] + g["zram"] for g in sess), T(f"{len(sess)} sessions Claude en tout : ", f"{len(sess)} Claude sessions in all: ") + _gb(sum(g['ram'] + g['zram'] for g in sess))))
        items.sort(key=lambda x: -x[0])
        return "\n".join("• " + t for _, t in items[:4])

    def event(self, now, kind, text, **extra):
        """Un événement : texte lisible, plus des champs pour la fenêtre des événements
        (name, group, delta en octets, used = RAM utilisée alors, slope/series pour une fuite…)."""
        rec = dict(k="event", t=round(now), kind=kind, text=text, **extra)
        self.write(rec)
        return dict(type="event", event=rec)

    def notify(self, title, body, urgency="normal", actions=False):
        if not self.leader:
            return
        import subprocess
        cmd = ["omarchy-notification-send", "--app-name", "Ardoise", "-g", "󰍛", "-u", urgency, title, body]
        if actions:
            if HAS_CLAUDE:
                cmd += ["--action", T("Analyser avec Claude", "Analyse with Claude"), os.path.realpath(__file__),
                        "analyser", "--lang", LANG_, "--raison", title]
            cmd += ["--action", T("Ouvrir Ardoise", "Open Ardoise"), "omarchy-shell", "io.github.smilecry44.ardoise", "openWindow"]
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            try:
                subprocess.Popen(["notify-send", "-a", "Ardoise", "-u", urgency, title, body], start_new_session=True)
            except OSError:
                pass


# ---------- flux pour le widget ----------

def flux():
    """Une ligne JSON par relevé. Le système toutes les 2 s ; le bilan par catégorie
    toutes les 30 s, ou toutes les 3 s avec le détail des processus quand la fenêtre
    ou la carte est ouverte."""
    tr = Tracker()
    seuil = 85
    if "--seuil" in sys.argv:
        try:
            seuil = float(sys.argv[sys.argv.index("--seuil") + 1])
        except (IndexError, ValueError):
            pass
    w = Watcher(seuil)
    opened = False

    def emit(o):
        sys.stdout.write(json.dumps(o, ensure_ascii=False, separators=(",", ":")) + "\n")

    emit(dict(type="hw", hw=hardware()))
    emit(w.backlog(KEEP_HOURS))
    sys.stdout.flush()
    last_full = 0
    last_lead_try = time.time()
    tr.system()
    w.on_bilan(tr.bilan(pads_max_age=30))  # premier relevé CPU et état de départ
    while True:
        r, _, _ = select.select([sys.stdin], [], [], 2.0)
        force = False
        if r:
            line = sys.stdin.readline()
            if not line:
                return  # le shell s'est arrêté
            cmd = line.strip()
            if cmd == "open":
                opened, force = True, True
            elif cmd == "close":
                opened = False
            elif cmd == "tick":
                force = True
        sysd = tr.system()
        out = [sysd]
        minute = w.on_system(sysd)
        if minute:
            out.append(minute)
        since = time.time() - last_full
        if (opened and (force or since >= 3)) or (not opened and since >= 30):
            b = tr.bilan(pads_max_age=30, with_procs=opened)
            out.extend(w.on_bilan(b))
            out.append(b)
            last_full = time.time()
        if not w.leader and time.time() - last_lead_try > 30:  # le chef a peut-être disparu
            w.try_lead()
            last_lead_try = time.time()
        for o in out:
            emit(o)
        sys.stdout.flush()


USAGE_EN = """ardoise: who is using the machine, in lines that add up to the total.

Usage: ardoise [--json] [--all]       readable breakdown, or JSON
       ardoise --court                 percentage of RAM in use (for the bar)
       ardoise --flux                  one JSON line every 2 s (for the widget);
                                       reads "open" / "close" / "tick" on stdin
       ardoise --flux --seuil 85       RAM alert threshold (%)
       ardoise fermer <pid>            stop a Claude session (resume it with --resume)
       ardoise vider <session id>      delete the scratchpad of a closed session
       ardoise montrer <pid>           show a session's conversation in Herdr
       ardoise analyser [--raison …]   full report + a Claude conversation to analyse it
       ardoise action <verb> <pid>…    pause | reprendre | priorite | normal | terminer | tuer
       ardoise liberer <GB>            suggest what to close to free that much (JSON)
       ardoise appliquer <item>…       session:<pid> vider:<id> app:<pid+pid…>
       --lang fr|en                    language (else ARDOISE_LANG, the plugin's "language"
                                       setting in shell.json, then the system language)
"""


def main():
    a = sys.argv[1:]
    if a[:1] in (["-h"], ["--help"], ["aide"], ["help"]):
        print(T(__doc__.replace("(ardoise: who is using the machine, in lines that add up to the total.)\n", ""), USAGE_EN))
        return
    if a[:1] == ["fermer"] and len(a) > 1:
        return fermer(int(a[1]))
    if a[:1] == ["vider"] and len(a) > 1:
        return vider(a[1])
    if a[:1] == ["analyser"]:
        raison = a[a.index("--raison") + 1] if "--raison" in a and a.index("--raison") + 1 < len(a) else None
        return analyser(raison)
    if a[:1] == ["montrer"] and len(a) > 1:
        return montrer(int(a[1]))
    if a[:1] == ["action"] and len(a) > 2:
        return action(a[1], [int(x) for x in a[2:]])
    if a[:1] == ["liberer"] and len(a) > 1:
        print(json.dumps(panier(float(a[1].rstrip("Gg").replace(",", ".")) * GO), ensure_ascii=False))
        return
    if a[:1] == ["appliquer"]:
        return appliquer(a[1:])
    if "--flux" in a:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
        return flux()
    if a[:1] == ["machine"]:
        m = machine()
        if "--json" in a:
            print(json.dumps(m, ensure_ascii=False))
        else:
            print(m["text_ip"] if "--ip" in a else m["text"])
        return
    if "--materiel" in a:
        print(json.dumps(hardware(), ensure_ascii=False, indent=1))
        return
    if "--court" in a:
        mi = meminfo()
        print(round(100 * (mi["MemTotal"] - mi["MemAvailable"]) / mi["MemTotal"]))
        return
    b = bilan()
    if "--json" in a:
        json.dump(b, sys.stdout, ensure_ascii=False, indent=1)
        print()
    else:
        show(b, "--all" in a)


if __name__ == "__main__":
    main()
