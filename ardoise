def h(n):
    n = float(n)
    if abs(n) >= GO:
        return f"{n / GO:5.1f} {GO_U}"
    return f"{n / 1024 ** 2:5.0f} {MO_U}"


def dur(s):
    s = int(s)
    if s >= 86400:
        return f"{s // 86400} {T('j', 'd')} {s % 86400 // 3600} h"
    if s >= 3600:
        return f"{s // 3600} h {s % 3600 // 60:02d}"
    return f"{s // 60} min"


def bar(part, total, width=24):
    n = round(width * part / total) if total else 0
    return "█" * n + "·" * (width - n)


