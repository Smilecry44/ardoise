def _plugin_entry():
    """L'entrée {"id": "io.github.smilecry44.ardoise", …} de la barre dans ~/.config/omarchy/shell.json."""
    try:
        data = json.load(open(os.path.join(HOME, ".config", "omarchy", "shell.json")))
    except (OSError, ValueError):
        return {}
    stack = [data]
    while stack:
        x = stack.pop()
        if isinstance(x, dict):
            if x.get("id") == "io.github.smilecry44.ardoise":
                return x
            stack.extend(x.values())
        elif isinstance(x, list):
            stack.extend(x)
    return {}


SETTINGS = _plugin_entry()


def _norm_lang(v):
    v = str(v or "").strip().lower()
    if not v or v == "auto":
        return None
    return "fr" if v.startswith("fr") else "en"


def _resolve_lang():
    """--lang (retiré de argv), ARDOISE_LANG, réglage « language » du plugin, langue du système."""
    a = sys.argv
    for i, v in enumerate(a):
        if v == "--lang":
            val = a[i + 1] if i + 1 < len(a) else ""
            del a[i:i + 2]
            if _norm_lang(val):
                return _norm_lang(val)
            break
        if v.startswith("--lang="):
            del a[i]
            if _norm_lang(v[7:]):
                return _norm_lang(v[7:])
            break
    for v in (os.environ.get("ARDOISE_LANG"), SETTINGS.get("language")):
        if _norm_lang(v):
            return _norm_lang(v)
    for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(k)
        if v:
            return "fr" if v.lower().startswith("fr") else "en"
    return "en"


