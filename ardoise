VERBS = {"pause": signal.SIGSTOP, "reprendre": signal.SIGCONT, "terminer": signal.SIGTERM, "tuer": signal.SIGKILL}


def action(verb, pids):
    procs = processes()
    done = []
    for pid in pids:
        p = procs.get(pid)
        if not p:
            continue
        if protected(p):
            print(T(f"{p['comm']} ({pid}) est protégé : on n'y touche pas", f"{p['comm']} ({pid}) is protected: left alone"), file=sys.stderr)
            continue
        try:
            if verb in VERBS:
                os.kill(pid, VERBS[verb])
            elif verb == "priorite":
                os.setpriority(os.PRIO_PROCESS, pid, 10)
            elif verb == "normal":
                if p["nice"] > 0:
                    try:
                        os.setpriority(os.PRIO_PROCESS, pid, 0)
                    except PermissionError:
                        print(T(f"{p['comm']} ({pid}) : remonter la priorité demande les droits root", f"{p['comm']} ({pid}): raising priority needs root"), file=sys.stderr)
                        continue
            else:
                sys.exit(T(f"verbe inconnu : {verb}", f"unknown verb: {verb}"))
            done.append(f"{p['comm']} ({pid})")
        except (ProcessLookupError, PermissionError) as e:
            print(f"{p['comm']} ({pid}) : {e}", file=sys.stderr)
    if not done:
        sys.exit(T("rien n'a été fait", "nothing was done"))
    print(f"{verb} : " + ", ".join(done))


def appliquer(items):
    for item in items:
        for part in item.split(","):
            kind, _, val = part.partition(":")
            if kind == "session":
                fermer(int(val))
            elif kind == "vider":
                vider(val, wait=8)
            elif kind == "app":
                action("terminer", [int(x) for x in val.split("+") if x])


