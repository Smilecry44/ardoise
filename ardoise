MOIS = ("janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août",
        "septembre", "octobre", "novembre", "décembre")
MONTHS = ("January", "February", "March", "April", "May", "June", "July", "August",
          "September", "October", "November", "December")


def _fastfetch():
    """Ce que fastfetch sait (écrans, disques, système…), par type. Vide sans fastfetch."""
    import subprocess
    if not shutil.which("fastfetch"):
        return {}
    mods = "host:board:bios:cpu:gpu:display:disk:swap:os:kernel:wm:packages:localip"
    try:
        out = subprocess.run(["fastfetch", "--format", "json", "-s", mods], capture_output=True, text=True, timeout=8).stdout
        return {x["type"]: x.get("result") for x in json.loads(out) if x.get("result") is not None}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return {}


def _num(v, d=1):
    s = f"{v:.{d}f}"
    return s.replace(".", ",") if FR else s


def _int_sp(n):
    """1467 → « 1 467 » en français, « 1,467 » en anglais."""
    s = f"{int(n):,}"
    return s.replace(",", "\u00a0") if FR else s


def _gb_dec(n):
    """Taille d'un disque en Go décimaux, comme le constructeur l'annonce."""
    g = n / 1e9
    return f"{_int_sp(round(g))}" if g >= 10 else _num(g)


def _encrypted(dev):
    """Le périphérique passe-t-il par LUKS ?"""
    name = os.path.basename(os.path.realpath(dev)) if dev.startswith("/dev/") else ""
    for _ in range(6):
        if not name:
            return False
        if (read(f"/sys/class/block/{name}/dm/uuid") or "").startswith("CRYPT-"):
            return True
        slaves = glob.glob(f"/sys/class/block/{name}/slaves/*")
        name = os.path.basename(slaves[0]) if slaves else None
    return False


def _transport(disk):
    if not disk:
        return ""
    if disk.startswith("nvme"):
        return "NVMe"
    if (read(f"/sys/block/{disk}/queue/rotational") or "").strip() == "1":
        return T("disque dur", "hard drive")
    return "SSD" if disk.startswith("sd") else ""


def _installed_on():
    """Date d'installation : la première ligne du journal de pacman, sinon la naissance de /."""
    m = re.match(r"\[(\d{4})-(\d{2})-(\d{2})", read("/var/log/pacman.log") or "")
    if m:
        return time.mktime((int(m[1]), int(m[2]), int(m[3]), 0, 0, 0, 0, 0, -1))
    import subprocess
    try:
        w = int(subprocess.run(["stat", "-c", "%W", "/"], capture_output=True, text=True, timeout=3).stdout.strip())
        return w or None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def _terminal():
    """Le terminal par défaut d'Omarchy (xdg-terminal-exec), par son nom lisible."""
    for line in (read(os.path.join(HOME, ".config", "xdg-terminals.list")) or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        for d in (os.path.join(HOME, ".local/share/applications"), "/usr/share/applications"):
            m = re.search(r"^Name=(.+)$", read(os.path.join(d, line)) or "", re.M)
            if m:
                return m.group(1).strip()
        return line.rsplit(".", 2)[-2] if line.endswith(".desktop") else line
    return ""


def _shell():
    import subprocess
    sh = os.environ.get("SHELL") or ""
    name = os.path.basename(sh)
    if not name:
        return ""
    try:
        out = subprocess.run([sh, "--version"], capture_output=True, text=True, timeout=3).stdout
        m = re.search(r"(\d+\.\d+(?:\.\d+)?)", out)
        return f"{name} {m.group(1)}" if m else name
    except (OSError, subprocess.SubprocessError):
        return name


def _ago(days):
    if days < 1:
        return T("aujourd'hui", "today")
    if days < 2:
        return T("hier", "yesterday")
    if days < 60:
        return T(f"il y a {days} jours", f"{days} days ago")
    months = round(days / 30.4)
    if months < 24:
        return T(f"il y a {months} mois", f"{months} months ago")
    return T(f"il y a {days // 365} ans", f"{days // 365} years ago")


def machine():
    """La fiche de la machine : matériel, logiciel, état. Chaque ligne est déjà écrite
    dans la langue choisie ; `text` est la même fiche en Markdown, à coller sur un forum
    (sans numéro de série ni nom d'utilisateur ; `text_ip` y ajoute l'IP locale)."""
    ff = _fastfetch()
    hw = hardware()
    sections = []

    def row(label, value, detail="", **kw):
        return dict(label=label, value=value, detail=detail, **kw)

    # ── matériel ──
    rows = []
    board = ff.get("Board") or ff.get("Host") or {}
    if board.get("name"):
        vendor = _short_vendor(board.get("vendor")) or (board.get("vendor") or "").split()[0]
        if vendor.lower().startswith("gigabyte"):
            vendor = "Gigabyte"
        bios = ff.get("BIOS") or {}
        bd = ""
        m = re.match(r"(\d{2})/(\d{2})/(\d{4})", bios.get("date") or "")
        if m:
            bd = (MOIS if FR else MONTHS)[int(m[1]) - 1] + " " + m[3]
        detail = " · ".join(x for x in ("BIOS " + bios["version"] if bios.get("version") else "", bd, bios.get("type") or "") if x)
        rows.append(row(T("carte mère", "motherboard"), f"{vendor} {board['name']}".strip(), detail))

    cpu = ff.get("CPU") or {}
    cpu_name = cpu.get("cpu") or (hw.get("cpu") or "").split(" · ")[0]
    if cpu_name:
        cores = (cpu.get("cores") or {})
        bits = []
        if cores.get("physical"):
            bits.append(T(f"{cores['physical']} cœurs, {cores.get('logical') or NCPU} fils", f"{cores['physical']} cores, {cores.get('logical') or NCPU} threads"))
        elif hw.get("cpu"):
            bits.append(hw["cpu"].split(" · ", 1)[-1])
        fmax = (cpu.get("frequency") or {}).get("max")
        if fmax:
            bits.append(T(f"{_num(fmax / 1000, 2)} GHz max", f"{_num(fmax / 1000, 2)} GHz max"))
        t = cpu_temp()
        if t:
            bits.append(f"{t:.0f}°")
        rows.append(row(T("processeur", "processor"), cpu_name, " · ".join(bits)))

    g = gpu()
    gpus = [x for x in (ff.get("GPU") or []) if x.get("name")]
    if hw.get("gpu") or gpus:
        name = hw["gpu"].split(" · ")[0] if hw.get("gpu") else f"{gpus[0].get('vendor') or ''} {gpus[0]['name']}".strip()
        bits = []
        if g["vram_total"]:
            bits.append(f"{g['vram_total'] / GO:.0f} {GO_U} VRAM")
        if gpus and gpus[0].get("driver"):
            bits.append(gpus[0]["driver"])
        if g["temp"]:
            bits.append(f"{g['temp']:.0f}°")
        rows.append(row(T("graphique", "graphics"), name, " · ".join(bits)))
        for other in gpus[1:]:
            rows.append(row("", f"{other.get('vendor') or ''} {other['name']}".strip(), T("intégrée", "integrated") if other.get("type") == "Integrated" else ""))

    mi = meminfo()
    used = mi["MemTotal"] - mi["MemAvailable"]
    rows.append(row(T("mémoire", "memory"), hw.get("mem") or f"{mi['MemTotal'] / GO:.0f} {GO_U}", "",
                    bar=used / mi["MemTotal"], kind="mem",
                    amount=f"{_num(used / GO)} / {_num(mi['MemTotal'] / GO)} {GO_U}", pct=f"{100 * used / mi['MemTotal']:.0f} %"))
    swaps = []
    for s in ff.get("Swap") or []:
        n = s.get("name") or ""
        nm = "zram" if "zram" in n else "partition" if n.startswith("/dev/") else T("fichier", "file")
        swaps.append(f"{nm} {_num((s.get('used') or 0) / GO)} / {_num((s.get('total') or 0) / GO)} {GO_U}")
    if swaps:
        rows.append(row("swap", "", " · ".join(swaps)))
    sections.append(dict(key="hw", title=T("matériel", "hardware"), rows=rows))

    # ── disques, écrans, réseau (dans le bloc matériel, après un trait) ──
    rows = []
    seen, first = set(), True
    for d in ff.get("Disk") or []:
        src = d.get("mountFrom") or ""
        if "Subvolume" in (d.get("volumeType") or []) or src in seen:
            continue
        seen.add(src)
        total = (d.get("bytes") or {}).get("total") or 0
        free = (d.get("bytes") or {}).get("free") or 0
        if not total:
            continue
        mp = d.get("mountpoint") or ""
        mp_short = "~" + mp[len(HOME):] if mp.startswith(HOME + "/") else mp
        fs = d.get("filesystem") or ""
        disk = _disk_of(mp) if src.startswith("/dev/") else None
        model = (read(f"/sys/block/{disk}/device/model") or "").strip() if disk else ""
        enc = T(" chiffré", " encrypted") if src.startswith("/dev/") and _encrypted(src) else ""
        detail = " · ".join(x for x in (mp_short, fs + enc, _transport(disk)) if x)
        rows.append(row(T("disques", "disks") if first else "", model or src.split(":")[0] or mp_short, detail,
                        bar=(total - free) / total, kind="disk",
                        amount=f"{_gb_dec(total - free)} / {_gb_dec(total)} {GO_U}", pct=f"{100 * (total - free) / total:.0f} %"))
        first = False
    first = True
    for s in sorted(ff.get("Display") or [], key=lambda s: not (s.get("name") or "").strip("\x00 ")):
        o = s.get("output") or {}
        if not o.get("width"):
            continue
        name = (s.get("name") or "").strip("\x00 ") or T("sans nom", "unnamed")
        ph = s.get("physical") or {}
        inch = f"{(ph['width'] ** 2 + ph['height'] ** 2) ** 0.5 / 25.4:.0f}\"" if ph.get("width") and ph.get("height") else ""
        hz = f"{o['refreshRate']:.0f} Hz" if o.get("refreshRate") else ""
        rows.append(row(T("écrans", "displays") if first else "", name, "", res=f"{o['width']}×{o['height']}", hz=hz, inch=inch))
        first = False
    if hw.get("net"):
        chip, _, rest = hw["net"].partition(" · ")
        rows.append(row(T("réseau", "network"), chip.strip(), rest))
    sections.append(dict(key="hw2", title="", rows=rows))

    # ── logiciel ──
    rows = []
    osr = ff.get("OS") or {}
    if not osr:  # sans fastfetch : /etc/os-release
        kv = dict(re.findall(r'^(\w+)="?([^"\n]*)"?$', read("/etc/os-release") or "", re.M))
        osr = dict(prettyName=kv.get("PRETTY_NAME") or kv.get("NAME"), versionID=kv.get("BUILD_ID") or kv.get("VERSION_ID"), idLike=kv.get("ID_LIKE"))
    os_name = osr.get("prettyName") or osr.get("name") or "Linux"
    rows.append(row(T("système", "system"), f"{os_name} {osr.get('versionID') or osr.get('buildID') or ''}".strip(),
                    T("base ", "based on ") + osr["idLike"].capitalize() if osr.get("idLike") else ""))
    k = ff.get("Kernel") or {}
    rows.append(row(T("noyau", "kernel"), f"{k.get('name') or 'Linux'} {k.get('release') or os.uname().release}"))
    wm = ff.get("WM") or {}
    if wm.get("prettyName"):
        rows.append(row(T("bureau", "desktop"), f"{wm['prettyName']} {wm.get('version') or ''}".strip(), wm.get("protocolName") or ""))
    theme = (read(os.path.join(HOME, ".local/state/omarchy/current/theme.name")) or "").strip()
    if theme:
        rows.append(row(T("thème", "theme"), re.sub(r"(^|-)([a-z])", lambda m: m[1] + m[2].upper(), theme).replace("-", " ")))
    term, sh = _terminal(), _shell()
    if term or sh:
        rows.append(row("terminal", term or sh, sh if term else ""))
    p = ff.get("Packages") or {}
    if p.get("all"):
        kinds = ", ".join(f"{_int_sp(v)} {k_}" for k_, v in p.items() if k_ != "all" and isinstance(v, int) and v)
        rows.append(row(T("paquets", "packages"), _int_sp(p["all"]), kinds if "," in kinds else kinds.split(" ", 1)[-1]))
    sections.append(dict(key="sw", title=T("logiciel", "software"), rows=rows))

    # ── état ──
    rows = []
    up = float((read("/proc/uptime") or "0").split()[0])
    boot = time.time() - up
    bt = time.localtime(boot)
    today = time.strftime("%Y%m%d", bt) == time.strftime("%Y%m%d")
    when = time.strftime(T("à %H:%M", "since %H:%M") if today else T("le %d/%m à %H:%M", "since %m/%d %H:%M"), bt)
    rows.append(row(T("allumée", "up"), T("depuis ", "for ") + dur(up), when))
    inst = _installed_on()
    if inst:
        rows.append(row(T("installée", "installed"), _ago(int((time.time() - inst) // 86400)), time.strftime(T("%d/%m/%Y", "%Y-%m-%d"), time.localtime(inst))))
    la = os.getloadavg()
    rows.append(row(T("charge", "load"), " · ".join(_num(x, 2) for x in la), T(f"sur {NCPU} fils", f"over {NCPU} threads")))
    ip = next((x for x in ff.get("LocalIp") or [] if x.get("ipv4")), None)
    if ip:
        rows.append(row(T("IP locale", "local IP"), ip["ipv4"].split("/")[0], ip.get("name") or "", private=True))
    sections.append(dict(key="state", title=T("état", "status"), rows=rows))

    for s in sections:  # blocs étroits : le détail suit la valeur sur la même ligne
        if s["key"] in ("sw", "state"):
            for r in s["rows"]:
                r["inline"] = True

    # ── en une ligne, pour le sous-titre ──
    short = [cpu_name.replace("AMD ", "").replace("Intel(R) Core(TM) ", ""),
             (hw.get("gpu") or "").split(" · ")[0].replace("AMD ", ""), hw.get("mem", "").split(" ")[0] + f" {GO_U}" if hw.get("mem") else ""]
    disks_total = sum(((d.get("bytes") or {}).get("total") or 0) for d in ff.get("Disk") or [] if "Subvolume" not in (d.get("volumeType") or []))
    if disks_total:
        short.append(T(f"{_num(disks_total / 1e12, 0 if disks_total >= 2e12 else 1)} To de disques", f"{_num(disks_total / 1e12, 0 if disks_total >= 2e12 else 1)} TB of disks"))
    nd = len([s for s in ff.get("Display") or [] if (s.get("output") or {}).get("width")])
    if nd:
        short.append(T(f"{nd} écran" + ("s" if nd > 1 else ""), f"{nd} display" + ("s" if nd > 1 else "")))

    def text(with_ip):
        out = ["```"]
        for s in sections:
            if s["title"]:
                if len(out) > 1:
                    out.append("")
                out.append(s["title"].capitalize())
            for r in s["rows"]:
                if r.get("private") and not with_ip:
                    continue
                val = r["value"]
                if r.get("res"):
                    val = " · ".join(x for x in (val, r["res"], r.get("hz"), r.get("inch")) if x)
                if r.get("amount"):
                    val = f"{val} · {r['amount']} ({r['pct'].replace(' ', '')})" if val else r["amount"]
                if r["detail"] and r.get("kind") != "mem":
                    val = f"{val} · {r['detail']}" if val else r["detail"]
                lab = r["label"][:1].upper() + r["label"][1:] if r["label"] else ""
                out.append(f"  {lab:<12}{val}")
        out += ["```", T("— fiche Ardoise", "— Ardoise machine card")]
        return "\n".join(out)

    return dict(subtitle=" · ".join(x for x in short if x.strip()), uptime=dur(up),
                sections=sections, text=text(False), text_ip=text(True),
                has_fastfetch=bool(ff))


_spaces_cache = {"t": 0, "v": {}}


def herdr_spaces():
    """terminal Herdr -> nom de son espace (relu toutes les 30 s, seulement fenêtre ouverte)."""
    if time.time() - _spaces_cache["t"] < 30:
        return _spaces_cache["v"]
    import subprocess
    m = {}
    try:
        ls = json.loads(subprocess.run(["herdr-app", "ls"], capture_output=True, text=True, timeout=3).stdout)
        for sp in ls.get("spaces", []):
            for tb in sp.get("tabs", []):
                for t in tb.get("terminals", []):
                    m[t.get("terminal")] = sp.get("name")
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    _spaces_cache.update(t=time.time(), v=m)
    return m


# ---------- regroupement ----------

GENERIC = re.compile(r"(wayland-wm@|session\.slice/[^/]*$|init\.scope$|user@\d+\.service/init\.scope)")


def label_app(p):
    cg = p["cgroup"].encode().decode("unicode_escape", errors="ignore")
    if GENERIC.search(cg):
        return p["comm"]
    if re.search(r"/hc-hold-[0-9a-f]+\.service$", cg):
        return "herdr · terminaux"
    m = re.search(r"app-(?:Hyprland-|flatpak-)?([^/]+?)(?:@[^/]*)?-[0-9a-f]+\.scope$", cg) or \
        re.search(r"app-(?:Hyprland-|flatpak-)?([^/]+?)(?:@[^/]*)?\.service$", cg)
    if m:
        name = m.group(1)
        return name.split(".")[-1] if name.count(".") >= 2 else name  # org.chromium.Chromium -> Chromium
    m = re.search(r"/([^/]+)\.(service|scope)$", cg)
    return m.group(1) if m else p["comm"]


def mcp_name(p):
    """Nom lisible d'un enfant de claude : le paquet lancé plutôt que npm, uv ou node."""
    argv = p["argv"]
    if len(argv) == 1 and " " in argv[0].strip():  # npm réécrit son titre en une seule chaîne
        argv = argv[0].split()
    prog = os.path.basename(argv[0])
    if prog.startswith("gk_"):
        return "gitkraken"
    if prog in ("bash", "sh", "zsh"):
        return "shell"
    if prog in ("npm", "npx", "uv", "uvx", "node", "bun", "bunx", "pnpm") or prog.startswith("python"):
        for a in argv[1:]:
            if a.startswith("-") or a in ("exec", "tool", "run", "x", "uvx", "dlx", "--"):
                continue
            if not a.startswith("@") or a.count("@") > 1:
                a = re.sub(r"@[\w.^~-]+$", "", a)
            return os.path.basename(a.split("/")[-1]) or prog
    return prog


def group_processes(procs, sessions):
    def claude_root(pid):
        seen = set()
        while pid in procs and pid not in seen:
            seen.add(pid)
            if pid in sessions:
                return pid
            pid = procs[pid]["ppid"]
        return None

    groups = {}
    for pid, p in procs.items():
        root = claude_root(pid)
        key = ("claude", root) if root else ("app", label_app(p))
        g = groups.setdefault(key, dict(kind=key[0], key=key[1], pids=[], ram=0, swap=0, cpu=0, cmds={}, cmdmem={}))
        g["pids"].append(pid)
        g["ram"] += p["ram"]
        g["swap"] += p["swap"]
        g["cpu"] += p["cpu"]
        name = p["comm"]
        if key[0] == "claude" and pid != root:
            top = pid  # rangé sous l'enfant direct de claude qui l'a lancé (un MCP, un shell…)
            while procs[top]["ppid"] != root and procs[top]["ppid"] in procs:
                top = procs[top]["ppid"]
            name = mcp_name(procs[top])
        p["group"] = f"{key[0]}:{key[1]}"
        p["label"] = name
        g["cmds"][name] = g["cmds"].get(name, 0) + 1
        g["cmdmem"][name] = g["cmdmem"].get(name, 0) + p["ram"] + p["swap"]
    return groups


def protected(p):
    return p["pid"] in (1, os.getpid()) or p["uid"] != UID or p["comm"] in PROTECTED


# ---------- bilan ----------

class Tracker:
    """Garde les relevés précédents pour calculer des vitesses (CPU, réseau, disque)
    et depuis quand chaque groupe ne fait plus rien."""

    def __init__(self):
        self.t = None
        self.cpu = None
        self.net = None
        self.disk = None
        self.proc_cpu = {}
        self.group_seen_active = {}
        self.boot = time.time() - float((read("/proc/uptime") or "0").split()[0])

    def system(self):
        now = time.time()
        mi = meminfo()
        z_used, z_orig = zram()
        cpu, net, disk = cpu_times(), net_bytes(), disk_bytes()
        out = dict(type="sys", time=now, has_claude=HAS_CLAUDE, total=mi["MemTotal"], used=mi["MemTotal"] - mi["MemAvailable"],
                   available=mi["MemAvailable"], swap_used=mi["SwapTotal"] - mi["SwapFree"],
                   zram=dict(used=z_used, data=z_orig), load=os.getloadavg(),
                   uptime=now - self.boot, disks=disk_usage(), gpu=gpu(), cpu_temp=cpu_temp(), ncpu=NCPU)
        if self.t is not None:
            dt = max(now - self.t, 1e-3)
            pct = [100 * (b[0] - a[0]) / max(b[1] - a[1], 1) for a, b in zip(self.cpu, cpu)]
            out.update(cpu=pct[0], cores=pct[1:],
                       net=dict(rx=(net[0] - self.net[0]) / dt, tx=(net[1] - self.net[1]) / dt),
                       disk=dict(read=(disk[0] - self.disk[0]) / dt, write=(disk[1] - self.disk[1]) / dt))
        else:
            out.update(cpu=0, cores=[0] * (len(cpu) - 1), net=dict(rx=0, tx=0), disk=dict(read=0, write=0))
        self.t, self.cpu, self.net, self.disk = now, cpu, net, disk
        return out

    def bilan(self, pads_max_age=0, with_procs=False):
        now = time.time()
        mi = meminfo()
        total = mi["MemTotal"]
        used = total - mi["MemAvailable"]
        z_used, z_orig = zram()
        procs = processes()
        sessions = {pid: s for pid, s in claude_sessions().items() if pid in procs}
        groups = group_processes(procs, sessions)
        pads = scratchpads(pads_max_age)

        # CPU par processus depuis le relevé précédent, en % de la machine entière
        prev, self.proc_cpu = self.proc_cpu, {}
        dt = getattr(self, "_bt", None)
        dt = (now - dt) if dt else None
        self._bt = now
        for pid, p in procs.items():
            key = (pid, p["start"])
            self.proc_cpu[key] = p["cpu"]
            p["cpu_pct"] = (100 * (p["cpu"] - prev[key]) / HZ / dt / NCPU) if dt and key in prev else 0.0

        swap_used = mi["SwapTotal"] - mi["SwapFree"]
        swap_procs = sum(g["swap"] for g in groups.values())
        swap_other = max(0, swap_used - swap_procs)  # surtout des pages de /tmp
        ratio = z_used / swap_used if swap_used and z_orig else 0  # RAM occupée par Go swappé

        live_sids = {}
        for pid, s in sessions.items():
            live_sids.setdefault(s["sessionId"], []).append(pid)
        owner = {sid: max(pids, key=lambda q: sessions[q].get("updatedAt", 0)) for sid, pids in live_sids.items()}

        _desc_budget[0] = 8
        rows = []
        for (kind, key), g in groups.items():
            gid = f"{kind}:{key}"
            cpu_pct = sum(procs[pid]["cpu_pct"] for pid in g["pids"])
            if cpu_pct > 0.5 or gid not in self.group_seen_active:
                self.group_seen_active[gid] = now
            roots = [pid for pid in g["pids"] if procs[pid]["ppid"] not in g["pids"]]
            row = dict(id=gid, kind=kind, ram=g["ram"], zram=g["swap"] * ratio, swapped=g["swap"],
                       procs=len(g["pids"]), cpu=cpu_pct, roots=roots,
                       protected=all(protected(procs[pid]) for pid in roots),
                       paused=all(procs[pid]["state"] == "T" for pid in roots),
                       cmds=sorted(g["cmds"].items(), key=lambda x: -x[1]), cmdmem=g["cmdmem"],
                       idle=now - self.group_seen_active[gid])
            if kind == "claude":
                s = sessions[key]
                sid = s["sessionId"]
                pad = pads.get(sid, (0, None)) if owner.get(sid) == key else (0, None)
                last = s.get("updatedAt", s.get("startedAt", 0)) / 1000
                env = read(f"/proc/{key}/environ", binary=True) or b""
                m_t = re.search(rb"(?:^|\0)HC_TERMINAL_ID=([^\0]+)", env)
                row["terminal"] = m_t.group(1).decode() if m_t else None
                row["space"] = herdr_spaces().get(row["terminal"]) if with_procs else None
                row.update(name=s.get("name") or os.path.basename(s.get("cwd", "")),
                           session=sid, pid=key, cwd=s.get("cwd"), status=s.get("status"),
                           age=now - (self.boot + procs[key]["start"] / HZ), idle=now - last,
                           scratch_size=pad[0], scratch_path=pad[1],
                           twins=[sessions[q].get("name") for q in live_sids.get(sid, []) if q != key])
                mcps = [c for c in g["cmds"] if c not in ("claude", "shell")]
                row["desc"] = T(f"Session Claude Code « {row['name']} » dans {s.get('cwd', '?')}. "
                                + (f"Elle a lancé {len(mcps)} serveurs MCP : {', '.join(mcps)}. " if mcps else "")
                                + "La facture compte aussi sa part de zram et son dossier /tmp. "
                                + "« fermer » l'arrête ; elle se reprend avec claude --resume.",
                                f"Claude Code session “{row['name']}” in {s.get('cwd', '?')}. "
                                + (f"It started {len(mcps)} MCP servers: {', '.join(mcps)}. " if mcps else "")
                                + "Its bill also counts its share of zram and its /tmp folder. "
                                + "“Close” stops it; resume it with claude --resume.")
            else:
                row.update(name=T(key, "herdr · terminals") if key == "herdr · terminaux" else key)
                row["desc"] = describe(key, exe_of(roots[0]) if roots else None, procs[roots[0]]["argv"] if roots else None)
            rows.append(row)

        tmpfs = tmpfs_mounts()
        tmpfs_total = sum(u for _, u in tmpfs)
        pss_shmem = sum(p["shm"] for p in procs.values())
        files_ram = max(0, mi["Shmem"] - pss_shmem)
        files_zram = swap_other * ratio
        tmp_factor = (files_ram + files_zram) / tmpfs_total if tmpfs_total else 0

        for r in rows:
            if r["kind"] == "claude":
                r["scratch"] = r["scratch_size"] * tmp_factor
                r["facture"] = r["ram"] + r["zram"] + r["scratch"]
            r["poids_mort"] = (r["ram"] + r["zram"] + r.get("scratch", 0)) / GO * r["idle"] / 3600

        orphans = []
        for sid, (sz, path) in pads.items():
            if sid not in live_sids and sz > 0:
                orphans.append(dict(session=sid, size=sz, cost=sz * tmp_factor, path=path))
        orphans.sort(key=lambda o: -o["size"])

        kernel = sum(mi.get(k, 0) for k in ("SUnreclaim", "KernelStack", "PageTables", "SecPageTables", "Percpu"))
        reserve = kernel_reserve()
        g = gpu()
        explained = sum(r["ram"] + r["zram"] for r in rows) + files_ram + files_zram + kernel + reserve + g["gtt"]

        clones, mem = {}, {}
        for r in rows:
            if r["kind"] == "claude":
                for c, n in r["cmds"]:
                    if c not in ("claude", "shell"):
                        clones[c] = clones.get(c, 0) + 1
                        mem[c] = mem.get(c, 0) + r["cmdmem"].get(c, 0)

        rows.sort(key=lambda r: -(r["ram"] + r["zram"]))
        out = dict(
            type="full", time=now, total=total, used=used, available=mi["MemAvailable"], has_claude=HAS_CLAUDE,
            zram=dict(used=z_used, data=z_orig),
            groups=rows,
            clones=sorted(({"name": c, "count": n, "mem": mem[c]} for c, n in clones.items() if n >= 3),
                          key=lambda x: -x["mem"]),
            personne=dict(files_ram=files_ram, files_zram=files_zram, tmpfs=tmpfs, tmpfs_total=tmpfs_total,
                          orphans=orphans, kernel=kernel, reserve=reserve, gpu=g["gtt"], tmp_factor=tmp_factor),
            ecart=used - explained,
        )
        if with_procs:
            labels = {}
            for p in procs.values():
                if p["label"] not in labels:
                    labels[p["label"]] = describe(p["label"], exe_of(p["pid"]), p["argv"])
            out["descs"] = {k: v for k, v in labels.items() if v}
            out["procs"] = [dict(pid=p["pid"], name=p["comm"], label=p["label"], group=p["group"],
                                 cmd=" ".join(p["argv"])[:160], ram=p["ram"], swap=p["swap"] * ratio,
                                 cpu=p["cpu_pct"], state=p["state"], nice=p["nice"], protected=protected(p))
                            for p in procs.values()]
        return out


def bilan():
    return Tracker().bilan()


# ---------- libérer de la place ----------

def panier(target, b=None):
    """Ce qu'il est le moins gênant de fermer pour libérer `target` octets.
    Ordre : scratchpads orphelins, doublons de conversation, sessions Claude endormies,
    puis applis endormies, chaque fois les plus lourdes à dormir d'abord (poids mort)."""
    b = b or Tracker().bilan()
    cands = []
    for o in b["personne"]["orphans"]:
        if o["cost"] > 1024 ** 2:
            cands.append(dict(kind="vider", id=f"vider:{o['session']}", gain=o["cost"], pain=0,
                              label=T(f"scratchpad de la session fermée {o['session'][:8]}", f"scratchpad of closed session {o['session'][:8]}")))
    for g in b["groups"]:
        if g["kind"] == "claude" and g["twins"] and not g["scratch_size"] and g["idle"] > 600:
            cands.append(dict(kind="session", id=f"session:{g['pid']}", gain=g["ram"] + g["zram"], pain=1,
                              label=g['name'] + T(" (ouverte deux fois)", " (open twice)"), idle=g["idle"]))
    for g in sorted((g for g in b["groups"] if g["kind"] == "claude" and not g["twins"] and g["idle"] > 1800),
                    key=lambda g: -g["poids_mort"]):
        gain = g["facture"]
        item_id = f"session:{g['pid']}" + (f",vider:{g['session']}" if g["scratch_size"] else "")
        cands.append(dict(kind="session", id=item_id, gain=gain, pain=2, idle=g["idle"],
                          label=f"session {g['name']}"))
    for g in sorted((g for g in b["groups"] if g["kind"] == "app" and not g["protected"]
                     and g["idle"] > 3600 and g["ram"] + g["zram"] > 50 * 1024 ** 2),
                    key=lambda g: -g["poids_mort"]):
        cands.append(dict(kind="app", id="app:" + "+".join(map(str, g["roots"])), gain=g["ram"] + g["zram"],
                          pain=3, idle=g["idle"], label=T("appli ", "app ") + g['name']))
    chosen, total = [], 0
    for c in cands:
        if total >= target:
            break
        chosen.append(c)
        total += c["gain"]
    return dict(target=target, total=total, enough=total >= target * 0.95, items=chosen)


# ---------- actions ----------

def fermer(pid, quiet=False):
    sessions = claude_sessions()
    if pid not in sessions or not os.path.exists(f"/proc/{pid}"):
        sys.exit(T(f"{pid} n'est pas une session Claude en cours", f"{pid} is not a running Claude session"))
    os.kill(pid, signal.SIGTERM)
    if not quiet:
        print(T(f"session {sessions[pid].get('name')} arrêtée ; reprise : claude --resume {sessions[pid]['sessionId']}",
                f"session {sessions[pid].get('name')} stopped; resume: claude --resume {sessions[pid]['sessionId']}"))
    return sessions[pid]["sessionId"]


def vider(sid, wait=0):
    if not re.fullmatch(r"[0-9a-f-]{36}", sid):
        sys.exit(T("id de session invalide", "invalid session id"))
    deadline = time.time() + wait
    while True:
        live = {s["sessionId"] for pid, s in claude_sessions().items() if os.path.exists(f"/proc/{pid}")}
        if sid not in live:
            break
        if time.time() >= deadline:
            sys.exit(T("cette session tourne encore : demande-lui de faire le ménage, ou ferme-la d'abord",
                       "this session is still running: ask it to clean up, or close it first"))
        time.sleep(0.3)
    for path in glob.glob(f"/tmp/claude-{UID}/*/{sid}"):
        real = os.path.realpath(path)
        if real.startswith(f"/tmp/claude-{UID}/") and os.path.isdir(real):
            shutil.rmtree(real, ignore_errors=True)
            print(T("supprimé : ", "deleted: ") + real)


def montrer(pid):
    """Affiche la conversation d'une session Claude dans Herdr et met Herdr devant.
    Passe par le mod Pilote (« pilote-outils.aller-<espace>:<terminal> ») qui décide de ce
    que montre la fenêtre ; sans lui, se rabat sur les commandes de Herdr."""
    import subprocess
    env = read(f"/proc/{pid}/environ", binary=True) or b""
    m = re.search(rb"(?:^|\0)HC_TERMINAL_ID=([^\0]+)", env)
    if not m:
        sys.exit(T("cette session ne tourne pas dans Herdr", "this session is not running in Herdr"))
    term = m.group(1).decode()
    try:
        ls = json.loads(subprocess.run(["herdr-app", "ls"], capture_output=True, text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        sys.exit(T("Herdr ne répond pas (la fenêtre est-elle ouverte ?)", "Herdr is not responding (is its window open?)"))
    where = None
    for sp in ls.get("spaces", []):
        for tb in sp.get("tabs", []):
            if any(t.get("terminal") == term for t in tb.get("terminals", [])):
                where = (sp["id"], tb["id"], sp.get("name"))
    if not where:
        sys.exit(T(f"le terminal {term} n'est dans aucun espace de Herdr", f"terminal {term} is not in any Herdr space"))
    r = subprocess.run(["herdr-app", "do", f"pilote-outils.aller-{where[0]}:{term}"], capture_output=True, text=True)
    if r.returncode != 0 or '"error"' in r.stdout:  # pas de Pilote : les commandes de Herdr
        subprocess.run(["herdr-app", "do", "space.select", "--id", where[0]], capture_output=True)
        subprocess.run(["herdr-app", "do", "tab.select", "--id", where[1]], capture_output=True)
        subprocess.run(["herdr-app", "do", "pane.focus", "--terminal", term], capture_output=True)
    subprocess.run(["hyprctl", "dispatch", "focuswindow", "class:herdr-app"], capture_output=True)
    print(T(f"conversation affichée dans Herdr ({where[2]})", f"conversation shown in Herdr ({where[2]})"))


def analyser(raison=None):
    """Écrit un relevé complet et ouvre une conversation Claude Code pour l'analyser, dans
    l'espace Herdr choisi (ARDOISE_ESPACE, réglage « herdrSpace »), sinon un espace « Ardoise »
    créé au besoin ; dans un terminal si Herdr n'est pas là. Sans Claude Code : erreur."""
    if not HAS_CLAUDE:
        print(T("Claude Code n'est pas installé (commande « claude » introuvable) : l'analyse est impossible.",
                "Claude Code is not installed (no “claude” command): analysis is unavailable."), file=sys.stderr)
        sys.exit(1)
    import io
    import contextlib
    import subprocess
    tr = Tracker()
    tr.bilan(pads_max_age=0)
    time.sleep(1.5)  # un deuxième relevé pour avoir le CPU
    b = tr.bilan(pads_max_age=30, with_procs=True)
    pct = 100 * b["used"] / b["total"]
    raison = raison or T(f"RAM à {pct:.0f} %", f"RAM at {pct:.0f}%")
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        show(b, False)
    descs = b.get("descs", {})
    procs = sorted(b["procs"], key=lambda p: -(p["ram"] + p["swap"]))[:20]
    events, leaks = [], []
    try:
        for l in open(HISTORY):
            r = json.loads(l)
            if r.get("k") == "event" and r["t"] > time.time() - 3 * 3600:
                events.append(r)
    except (OSError, ValueError):
        pass
    leaks = [e for e in events if e.get("kind") == "leak"]
    lines = [
        T(f"# Relevé Ardoise du {time.strftime('%d/%m/%Y à %H:%M')}", f"# Ardoise report, {time.strftime('%Y-%m-%d %H:%M')}"),
        "",
        T(f"Raison : {raison}.", f"Reason: {raison}."),
        "",
        T("## Bilan (la somme des lignes fait la RAM utilisée)", "## Breakdown (the lines add up to the RAM in use)"),
        "```text", buf.getvalue().rstrip(), "```",
        "",
        T("## Les plus gros groupes, et ce qu'ils sont", "## The biggest groups, and what they are"),
    ]
    for g in [g for g in b["groups"]][:15]:
        kind_ = T("session Claude", "Claude session") if g['kind'] == 'claude' else T("appli", "app")
        lines.append(f"- **{g['name']}** ({kind_}){T(' : ', ': ')}"
                     f"{_gb(g['ram'] + g['zram'])}, {g['procs']} {T('processus', 'processes')}, "
                     f"{T('calme depuis', 'idle for')} {dur(g['idle']).strip()}"
                     + (f", /tmp {_gb(g.get('scratch', 0))}" if g.get('scratch', 0) > 50 * 1024 ** 2 else "")
                     + (f", pid {g['pid']}" if g['kind'] == 'claude' else f", {T('pids racines', 'root pids')} {g['roots'][:5]}")
                     + f". {g.get('desc') or ''}")
    lines += ["", T("## Les 20 plus gros processus", "## The 20 biggest processes"), "",
              T("| pid | programme | RAM | CPU | commande |", "| pid | program | RAM | CPU | command |"), "|---|---|---|---|---|"]
    for p_ in procs:
        lines.append(f"| {p_['pid']} | {p_['label']} | {_gb(p_['ram'] + p_['swap'])} | {p_['cpu']:.1f} % | `{p_['cmd'][:90].replace('|', '/')}` |")
    lines += ["", T("## Événements des 3 dernières heures", "## Events of the last 3 hours"), ""]
    lines += [f"- {time.strftime('%H:%M', time.localtime(e['t']))} {e['text']}" for e in events[-25:]] or [T("- aucun", "- none")]
    if leaks:
        lines += ["", T("Fuites signalées : ", "Reported leaks: ") + ", ".join(e["text"] for e in leaks)]
    for go_ in (2, 4):
        pn = panier(go_ * GO, b)
