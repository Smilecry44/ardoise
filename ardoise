# ---------- lecture système ----------

def read(path, binary=False):
    try:
        with open(path, "rb" if binary else "r") as f:
            return f.read()
    except OSError:
        return None


def meminfo():
    out = {}
    for line in (read("/proc/meminfo") or "").splitlines():
        k, v = line.split(":", 1)
        out[k] = int(v.split()[0]) * KB
    return out


def zram():
    """Mémoire réellement occupée par la zram, et données qu'elle contient."""
    used = orig = 0
    for dev in glob.glob("/sys/block/zram*/mm_stat"):
        f = (read(dev) or "").split()
        if len(f) >= 3:
            orig += int(f[0])
            used += int(f[2])  # mem_used_total
    return used, orig


def proc_mem(pid):
    """(ram, swap, shmem) en octets. PSS pour nos processus, RSS sinon."""
    r = read(f"/proc/{pid}/smaps_rollup")
    if r:
        v = dict(re.findall(r"^(\w+):\s+(\d+) kB", r, re.M))
        shm = int(v.get("Pss_Shmem", 0))
        ram = int(v.get("Pss_Anon", 0)) + shm
        swap = int(v.get("SwapPss", v.get("Swap", 0)))
        return ram * KB, swap * KB, shm * KB
    s = read(f"/proc/{pid}/status")
    if not s:
        return 0, 0, 0
    v = dict(re.findall(r"^(\w+):\s+(\d+) kB", s, re.M))
    return (int(v.get("RssAnon", 0)) + int(v.get("RssShmem", 0))) * KB, int(v.get("VmSwap", 0)) * KB, 0


def processes():
    procs = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        pid = int(d)
        stat = read(f"/proc/{pid}/stat")
        if not stat:
            continue
        rp = stat.rfind(")")  # comm peut contenir des espaces et des parenthèses
        comm = stat[stat.find("(") + 1:rp]
        f = stat[rp + 2:].split()
        cmd = read(f"/proc/{pid}/cmdline", binary=True) or b""
        argv = [a.decode(errors="replace") for a in cmd.split(b"\0") if a]
        if not argv:  # thread noyau
            continue
        ram, swap, shm = proc_mem(pid)
        try:
            uid = os.stat(f"/proc/{pid}").st_uid
        except OSError:
            continue
        cg = (read(f"/proc/{pid}/cgroup") or "").strip().split("::")[-1]
        procs[pid] = dict(pid=pid, ppid=int(f[1]), comm=comm, argv=argv, state=f[0], nice=int(f[16]),
                          ram=ram, swap=swap, shm=shm, cpu=int(f[11]) + int(f[12]), start=int(f[19]),
                          uid=uid, cgroup=cg)
    return procs


def claude_sessions():
    """pid -> fiche de session écrite par Claude Code."""
    out = {}
    for f in glob.glob(f"{HOME}/.claude/sessions/*.json"):
        try:
            d = json.load(open(f))
            out[int(d["pid"])] = d
        except (OSError, ValueError, KeyError):
            pass
    return out


def du(path):
    total = 0
    for root, dirs, files in os.walk(path, onerror=lambda e: None):
        for n in files:
            try:
                total += os.lstat(os.path.join(root, n)).st_blocks * 512
            except OSError:
                pass
    return total


def tmpfs_mounts():
    out = []
    for line in open("/proc/mounts"):
        dev, mnt, fs = line.split()[:3]
        if fs == "tmpfs":
            try:
                st = os.statvfs(mnt)
            except OSError:
                continue
            used = (st.f_blocks - st.f_bfree) * st.f_frsize
            if used > 0:
                out.append((mnt.replace("\\040", " "), used))
    return out


_pads_cache = {"t": 0, "v": {}}


def scratchpads(max_age=0):
    """Dossiers de travail des sessions Claude dans /tmp : id de session -> (taille, chemin)."""
    if max_age and time.time() - _pads_cache["t"] < max_age:
        return _pads_cache["v"]
    out = {}
    for d in glob.glob(f"/tmp/claude-{UID}/*/*"):
        sid = os.path.basename(d)
        if re.fullmatch(r"[0-9a-f-]{36}", sid):
            out[sid] = (du(d), d)
    _pads_cache.update(t=time.time(), v=out)
    return out


def kernel_reserve():
    """Mémoire que le noyau ne compte jamais comme disponible (réserves des zones + cache gardé)."""
    total = 0
    for blk in re.split(r"\nNode ", read("/proc/zoneinfo") or ""):
        hi = re.search(r"\n\s+high\s+(\d+)", blk)
        lo = re.search(r"\n\s+low\s+(\d+)", blk)
        pr = re.search(r"protection: \(([^)]*)\)", blk)
        mg = re.search(r"managed\s+(\d+)", blk)
        if hi and lo and pr and mg:
            total += min(max(int(x) for x in pr.group(1).split(",")) + int(hi.group(1)), int(mg.group(1)))
            total += int(lo.group(1))  # part du cache que MemAvailable ne compte pas
    return total * PAGE


def first_int(path):
    try:
        return int((read(path) or "").split()[0])
    except (ValueError, IndexError):
        return None


def gpu():
    """Carte graphique AMD : charge, VRAM, mémoire système prêtée (GTT), température."""
    out = dict(busy=None, vram_used=0, vram_total=0, gtt=0, temp=None)
    for card in glob.glob("/sys/class/drm/card*/device"):
        b = first_int(f"{card}/gpu_busy_percent")
        if b is None:
            continue
        out["busy"] = max(out["busy"] or 0, b)
        out["vram_used"] += first_int(f"{card}/mem_info_vram_used") or 0
        out["vram_total"] += first_int(f"{card}/mem_info_vram_total") or 0
        out["gtt"] += first_int(f"{card}/mem_info_gtt_used") or 0
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        name = (read(f"{h}/name") or "").strip()
        t = first_int(f"{h}/temp1_input")
        if name == "amdgpu" and t:
            out["temp"] = t / 1000
    return out


def cpu_temp():
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if (read(f"{h}/name") or "").strip() in ("k10temp", "coretemp", "zenpower"):
            t = first_int(f"{h}/temp1_input")
            if t:
                return t / 1000
    return None


def cpu_times():
    """[(occupé, total)] : la machine puis chaque cœur."""
    out = []
    for line in (read("/proc/stat") or "").splitlines():
        if not line.startswith("cpu"):
            break
        v = [int(x) for x in line.split()[1:]]
        idle = v[3] + (v[4] if len(v) > 4 else 0)
        out.append((sum(v[:8]) - idle, sum(v[:8])))
    return out


def net_bytes():
    rx = tx = 0
    for line in (read("/proc/net/dev") or "").splitlines()[2:]:
        name, data = line.split(":", 1)
        if name.strip() == "lo":
            continue
        f = data.split()
        rx += int(f[0])
        tx += int(f[8])
    return rx, tx


DISK = re.compile(r"^(nvme\d+n\d+|sd[a-z]+|vd[a-z]+|mmcblk\d+)$")


def disk_bytes():
    r = w = 0
    for line in (read("/proc/diskstats") or "").splitlines():
        f = line.split()
        if len(f) > 9 and DISK.match(f[2]):
            r += int(f[5]) * 512
            w += int(f[9]) * 512
    return r, w


_disk_map = {"t": 0, "v": []}


def disk_usage():
    """Une ligne par disque physique : son modèle, son point de montage principal et son
    remplissage. `/` d'abord (c'est le chiffre de la pastille), puis les autres disques."""
    if time.time() - _disk_map["t"] > 60:  # quel système de fichiers est sur quel disque : relu chaque minute
        best = {}
        for line in open("/proc/mounts"):
            src, mnt, fs = line.split()[:3]
            if not src.startswith("/dev/") or fs in ("vfat", "squashfs", "iso9660"):
                continue
            mnt = mnt.replace("\\040", " ")
            disk = _disk_of(mnt)
            if not disk or not os.path.exists(f"/sys/block/{disk}"):
                continue
            if disk not in best or len(mnt) < len(best[disk]):
                best[disk] = mnt
        _disk_map.update(t=time.time(), v=sorted(best.items(), key=lambda x: (x[1] != "/", x[1])))
    out = []
    for disk, mnt in _disk_map["v"]:
        try:
            st = os.statvfs(mnt)
        except OSError:
            continue
        model = re.sub(r"\s+", " ", (read(f"/sys/block/{disk}/device/model") or disk).strip())
        out.append(dict(disk=disk, model=model, path=mnt.replace(HOME, "~"),
                        used=(st.f_blocks - st.f_bfree) * st.f_frsize, total=st.f_blocks * st.f_frsize))
    return out


