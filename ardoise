_desc_cache_path = os.path.join(os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache"), "ardoise", f"descriptions.{LANG_}.json")
_desc_cache = None
_desc_budget = [0]


def _load_desc_cache():
    global _desc_cache
    if _desc_cache is None:
        try:
            _desc_cache = json.load(open(_desc_cache_path))
        except (OSError, ValueError):
            _desc_cache = {}
    return _desc_cache


def _save_desc_cache():
    try:
        os.makedirs(os.path.dirname(_desc_cache_path), exist_ok=True)
        with open(_desc_cache_path + ".tmp", "w") as f:
            json.dump(_desc_cache, f, ensure_ascii=False)
        os.replace(_desc_cache_path + ".tmp", _desc_cache_path)
    except OSError:
        pass


def _desktop_comment(name):
    want = name.lower()
    for d in (f"{HOME}/.local/share/applications", "/usr/share/applications"):
        for f in glob.glob(f"{d}/*.desktop"):
            base = os.path.basename(f)[:-8].lower()
            if want not in (base, base.split(".")[-1]):
                continue
            txt = read(f) or ""
            for key in (("Comment[fr]", "GenericName[fr]") if FR else ()) + ("Comment", "GenericName"):
                m = re.search(rf"^{re.escape(key)}=(.+)$", txt, re.M)
                if m:
                    return m.group(1).strip()
    return None


def _pacman_desc(exe):
    import subprocess
    try:
        pkg = subprocess.run(["pacman", "-Qqo", exe], capture_output=True, text=True, timeout=3).stdout.strip()
        if not pkg:
            return None
        info = subprocess.run(["pacman", "-Qi", pkg], capture_output=True, text=True, timeout=3,
                              env={**os.environ, "LC_ALL": "C"}).stdout
        m = re.search(r"^Description\s*:\s*(.+)$", info, re.M)
        return T(f"Paquet {pkg} : {m.group(1).strip()}", f"Package {pkg}: {m.group(1).strip()}") if m else T(f"Paquet {pkg}.", f"Package {pkg}.")
    except (OSError, subprocess.SubprocessError):
        return None


def describe(name, exe=None, cmd=None):
    """Description en clair d'un groupe ou d'un programme. Dictionnaire, puis fichier
    .desktop, puis paquet pacman ; le résultat est gardé en cache sur le disque."""
    key = str(name).lower()
    if key in DESCRIPTIONS:
        return DESCRIPTIONS[key]
    for pre, text in PREFIXES:
        if key.startswith(pre):
            return text
    if exe and INTERPRETERS.match(os.path.basename(exe)) and cmd:
        script = next((a for a in cmd[1:] if not a.startswith("-")), None)
        return (T("Un script ", "A ") + os.path.basename(exe) + T("", " script") + (f"{T(' : ', ': ')}{script}" if script else "")
                + T(". Déplie pour voir la commande complète.", ". Expand to see the full command."))
    cache = _load_desc_cache()
    ck = f"{key}|{exe or ''}"
    if ck in cache:
        return cache[ck]
    if _desc_budget[0] <= 0:  # pas plus de quelques recherches par relevé
        return None
    _desc_budget[0] -= 1
    d = _desktop_comment(name) or (_pacman_desc(exe) if exe and exe.startswith("/usr/") else None)
    if not d and exe:
        d = T(f"Programme {exe}", f"Program {exe}")
    cache[ck] = d
    _save_desc_cache()
    return d


def exe_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/exe").replace(" (deleted)", "")
    except OSError:
        return None


# ---------- matériel ----------

def _lspci(addr):
    import subprocess
    try:
        out = subprocess.run(["lspci", "-mm", "-s", addr], capture_output=True, text=True, timeout=3).stdout
        f = re.findall(r'"([^"]*)"', out)
        return (f[1], f[2]) if len(f) >= 3 else (None, None)
    except (OSError, subprocess.SubprocessError):
        return None, None


def _short_vendor(v):
    v = v or ""
    for k, short in (("Advanced Micro Devices", "AMD"), ("NVIDIA", "NVIDIA"), ("Intel", "Intel"), ("Realtek", "Realtek"),
                     ("MEDIATEK", "MediaTek"), ("Qualcomm", "Qualcomm"), ("Broadcom", "Broadcom")):
        if k.lower() in v.lower():
            return short
    return v.split()[0] if v else ""


def _disk_of(path):
    """Disque physique qui porte `path` (en traversant LUKS, LVM…)."""
    try:
        dev = os.stat(path).st_dev
        sysp = f"/sys/dev/block/{os.major(dev)}:{os.minor(dev)}"
        name = os.path.basename(os.path.realpath(sysp)) if os.path.exists(sysp) else None
    except OSError:
        name = None
    if not name:  # btrfs : st_dev est un périphérique anonyme, on passe par /proc/mounts
        src = next((l.split()[0] for l in open("/proc/mounts") if l.split()[1] == path), "")
        name = os.path.basename(os.path.realpath(src)) if src.startswith("/dev/") else None
    seen = 0
    while name and seen < 6:
        seen += 1
        slaves = glob.glob(f"/sys/class/block/{name}/slaves/*")
        if slaves:
            name = os.path.basename(slaves[0])
            continue
        parent = os.path.basename(os.path.dirname(os.path.realpath(f"/sys/class/block/{name}")))
        if os.path.exists(f"/sys/class/block/{name}/partition") and parent:
            name = parent
            continue
        return name
    return name


def hardware():
    """Le nom du matériel, pour l'afficher à côté des titres."""
    hw = {}
    m = re.search(r"^model name\s*:\s*(.+)$", read("/proc/cpuinfo") or "", re.M)
    if m:
        name = re.sub(r"\s+\d+-Core Processor|\s+Processor|\(R\)|\(TM\)|CPU @.*", "", m.group(1)).strip()
        cores = len(set(re.findall(r"^core id\s*:\s*(\d+)", read("/proc/cpuinfo") or "", re.M))) or NCPU
        hw["cpu"] = f"{name} · {cores} " + T(f"cœurs, {NCPU} fils", f"cores, {NCPU} threads")
    total = meminfo()["MemTotal"]
    installed = 2 ** round(__import__("math").log2(total / GO)) if total else 0
    hw["mem"] = T(f"{installed} Go installés", f"{installed} GB installed") if installed else ""

    disk = _disk_of("/")
    if disk:
        model = (read(f"/sys/block/{disk}/device/model") or "").strip()
        size = int(read(f"/sys/block/{disk}/size") or 0) * 512 / 1e12
        if re.search(r"\d+\s*[TG]B\b", model):
            hw["disk"] = model  # le modèle dit déjà sa taille
        else:
            hw["disk"] = f"{model or disk} · {size:.0f} {T('To', 'TB')}" if size >= 1 else f"{model or disk} · {size * 1000:.0f} {GO_U}"

    for card in sorted(glob.glob("/sys/class/drm/card*/device")):
        if first_int(f"{card}/gpu_busy_percent") is None and not os.path.exists(f"{card}/mem_info_vram_total"):
            continue
        vendor, dev = _lspci(os.path.basename(os.path.realpath(card)))
        if not dev:
            continue
        name = re.sub(r"^.*\[(.+)\]$", r"\1", dev)
        vram = (first_int(f"{card}/mem_info_vram_total") or 0) / GO
        m = re.match(r"(.*?)(\d{4}) XT / (\d{4}) XT", name)
        if m:  # le pilote annonce deux modèles : la VRAM tranche (12 Go → le premier, 16 Go → le second)
            name = f"{m.group(1)}{m.group(3) if vram >= 15 else m.group(2)} XT"
        hw["gpu"] = f"{_short_vendor(vendor)} {name}".strip() + (f" · {vram:.0f} {GO_U} VRAM" if vram else "")
        break

    route = (read("/proc/net/route") or "").splitlines()[1:]
    iface = next((l.split()[0] for l in route if l.split()[1] == "00000000"), None)
    if iface:
        vendor, dev = _lspci(os.path.basename(os.path.realpath(f"/sys/class/net/{iface}/device")))
        speed = first_int(f"/sys/class/net/{iface}/speed")
        kind = "Wi-Fi" if os.path.exists(f"/sys/class/net/{iface}/wireless") else "Ethernet"
        chip = re.split(r"[ /]", dev)[0] if dev else iface
        hw["net"] = f"{_short_vendor(vendor)} {chip} · {kind}" + (f" {speed // 1000} Gb/s" if speed and speed >= 1000 else f" {speed} Mb/s" if speed and speed > 0 else "")
    return hw


